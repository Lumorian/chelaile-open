{
  "name": "chelaile-open",
  "private": true,
  "version": "0.3.0",
  "description": "车来了 App 开源复刻：Android 客户端 + TypeScript 协议研究栈",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @chelaile/web",
    "dev:server": "node packages/server/src/index.ts",
    "build": "npm run build -w @chelaile/web",
    "start": "node packages/server/src/index.ts",
    "cli": "node apps/cli/src/index.ts",
    "test": "node --test tests/*.test.ts",
    "test:live": "CHELAILE_LIVE=1 node --test tests/live.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
